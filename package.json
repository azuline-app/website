{
  "name": "azuline-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/headers.ts",
    "preview": "astro preview",
    "check": "astro check && biome check .",
    "format": "biome format --write .",
    "deploy": "bun run build && WRANGLER_SEND_METRICS=false wrangler pages deploy dist --project-name=azuline --branch=main"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.3",
    "typescript": "7",
    "wrangler": "^4.154.0"
  }
}
