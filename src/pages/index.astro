---
import Artwork from '../components/Artwork.astro';
import TopBar from '../components/TopBar.astro';
import { SITE } from '../data/site';
import Base from '../layouts/Base.astro';

const year = new Date().getFullYear();
---

<Base>
  <div class="screen">
    <TopBar />
    <main class="stage">
      <div class="copy">
        <h1 class="display">
          <span class="ln">A free,</span>
          <span class="ln">open&#8209;source</span>
          <span class="ln"
            >app for <span data-spk="star8 az .5 right:-.78 top:.06; star4 si .3 right:-1.12 top:.66; dot si .12 right:-.36 top:-.04"
              >artists.</span
            ></span
          >
        </h1>
        <p class="lede">We're building it now, so there's nothing to download yet. No AI will ever make, edit or train on the art in it.</p>
        <div class="actions">
          <a class="btn ink" href={SITE.github}
            ><svg class="gh" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57l-.02-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.62-5.48 5.92.43.37.82 1.1.82 2.22l-.01 3.29c0 .31.21.69.82.57A12 12 0 0 0 12 .3"
              ></path></svg
            >Follow on GitHub</a
          >
          <a class="btn line" href={`mailto:${SITE.email}`}
            ><svg class="i" viewBox="0 0 24 24" aria-hidden="true"
              ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
            >{SITE.email}</a
          >
        </div>
      </div>
      <Artwork />
    </main>
    <footer class="foot"><span>© {year} azuline</span></footer>
  </div>
</Base>

<script>
  import { initInk } from '../scripts/ink';
  import { decorate } from '../scripts/sparkle';

  decorate();
  initInk();
</script>
