---
interface Props {
  toggle?: boolean;
}
const { toggle = true } = Astro.props;
---

<header class="top">
  <a class="lockup" href="/" aria-label="azuline, home"
    ><img class="ic lt" src="/brand/azuline-icon.svg" alt="" /><img class="ic dk" src="/brand/azuline-icon-dark.svg" alt="" /><img
      class="wm lt"
      src="/brand/azuline-wordmark.svg"
      alt=""
    /><img class="wm dk" src="/brand/azuline-wordmark-white.svg" alt="" /></a
  >
  {
    toggle && (
      <button class="mode" id="mode" type="button" aria-label="Switch to dark mode">
        <svg class="i sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="i moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" />
        </svg>
      </button>
    )
  }
</header>

<script>
  import { initThemeToggle } from '../scripts/theme';

  const button = document.getElementById('mode');
  if (button instanceof HTMLButtonElement) initThemeToggle(button);
</script>
